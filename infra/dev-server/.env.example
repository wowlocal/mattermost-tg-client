# Copy to .env (or just run ./up.sh, which generates .env with random
# dev-only passwords if it does not exist). .env is git-ignored.
# DEVELOPMENT ONLY: never reuse these values anywhere real.

# Host port and bind address for the Mattermost HTTP server.
# Use MM_BIND_ADDRESS=0.0.0.0 to reach the server from a device on the LAN.
MM_PORT=8065
MM_BIND_ADDRESS=127.0.0.1
# Must match MM_PORT. Clients use it for permalinks, OAuth/SSO callbacks, etc.
MM_SITE_URL=http://localhost:8065

# Postgres (only reachable from inside the compose network).
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mattermost

# Accounts created by seed.py.
SEED_ADMIN_USERNAME=sysadmin
SEED_ADMIN_PASSWORD=change-me
# Shared password for alice, bob, carol and dave.
SEED_USER_PASSWORD=change-me
