# Copy to .env (git-ignored) and fill in. Never commit the key or put it in this directory.
#
# Absolute path of the APNs auth key (.p8) from developer.apple.com → Certificates, Identifiers & Profiles
# → Keys (one key with "Apple Push Notifications service (APNs)" enabled). The file is mounted read-only.
# For a wiring test without a real key, ./make-dev-key.sh writes a throwaway key and prints these lines.
APNS_KEY_FILE=/absolute/path/outside/the/repo/AuthKey_XXXXXXXXXX.p8
# The 10-character key id shown next to the key.
APNS_KEY_ID=XXXXXXXXXX
# The 10-character Apple Developer team id that owns the key and the app id.
APNS_TEAM_ID=XXXXXXXXXX
# The app's bundle id (the APNs topic).
APNS_TOPIC=org.relaychat.Relay
# debug logs every push ("Sending apple push notification"); info logs only failures and throughput.
LOG_LEVEL=debug
PUSH_PROXY_PORT=8066
